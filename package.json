{
  "name": "msc-scheduled-visibility",
  "version": "1.2.4",
  "private": true,
  "scripts": {
    "build": "wp-scripts build src/block-scheduling/index.js --output-path=build",
    "start": "wp-scripts start src/block-scheduling/index.js --output-path=build",
    "lint": "composer lint",
    "lint-fix": "composer lint-fix",
    "i18n:pot": "composer i18n:pot",
    "scan:phpcs": "bash scripts/security-scan.sh phpcs",
    "scan:phpstan": "bash scripts/security-scan.sh phpstan",
    "scan:semgrep": "bash scripts/security-scan.sh semgrep",
    "scan:secrets": "bash scripts/security-scan.sh secrets",
    "scan:deps": "bash scripts/security-scan.sh deps",
    "scan:wporg": "bash scripts/security-scan.sh wporg",
    "scan:all": "bash scripts/security-scan.sh all"
  },
  "devDependencies": {
    "@babel/runtime": "^7.29.2",
    "@wordpress/icons": "^13.0.0",
    "@wordpress/scripts": "^28.0.0"
  }
}
