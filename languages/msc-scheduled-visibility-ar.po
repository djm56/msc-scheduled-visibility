msgstr "غير مجدول — قم بتعطيل وإعادة تفعيل الإضافة."

#: includes/class-msc-scheduled-visibility-settings.php:718
msgid "WP-Cron"
msgstr "WP-Cron"

#: includes/class-msc-scheduled-visibility-settings.php:718
msgid "Disabled by DISABLE_WP_CRON — make sure a system cron calls wp-cron.php."
msgstr "معطل بواسطة DISABLE_WP_CRON — تأكد من أن cron للنظام يدعو wp-cron.php."

