<?xml version="1.0"?>
<ruleset name="MSC Scheduled Visibility">
  <description>PHPCS rules for MSC Scheduled Visibility</description>

  <rule ref="WordPress-Core" />
  <rule ref="WordPress-Docs" />
  <rule ref="WordPress-Extra" />

  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>*/node_modules/*</exclude-pattern>
  <exclude-pattern>*/dist/*</exclude-pattern>
  <exclude-pattern>*/tests/*</exclude-pattern>
  <!-- Generated by @wordpress/scripts; not ours to style. -->
  <exclude-pattern>*/build/*</exclude-pattern>

  <!--
    Class files are named after the plugin slug rather than the bare class name
    (class-msc-scheduled-visibility-module.php holds Module). This is the
    convention across the whole MSC plugin family, so the sniff is switched off
    rather than worked around.
  -->
  <rule ref="WordPress.Files.FileName.InvalidClassFileName">
    <severity>0</severity>
  </rule>

  <!--
    Without the text_domain property the I18n sniff accepts any domain, so a typo'd
    or copy-pasted domain would pass CI silently.
  -->
  <rule ref="WordPress.WP.I18n">
    <properties>
      <property name="text_domain" type="array" value="msc-scheduled-visibility"/>
    </properties>
  </rule>

  <arg name="extensions" value="php,css"/>

  <config name="minimum_supported_wp_version" value="5.9" />
</ruleset>
